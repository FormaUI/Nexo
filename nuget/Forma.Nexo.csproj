<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <StaticWebAssetBasePath>_content/nexo</StaticWebAssetBasePath>
    </PropertyGroup>

    <!-- The package a host references. It ships Nexo as the one bundled file wwwroot/nexo.js, which scripts/bundle.mjs makes from src/. -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>formaui-net.Nexo</PackageId>
        <Authors>Eyal Alon</Authors>
        <Description>Nexo is an embeddable language with no domain of its own: the host declares the typed vocabulary, and scripts use it to compute and shape data. Nexo checks every script against that vocabulary before it runs, and evaluates it, read-only, into immutable data.</Description>
        <PackageTags>nexo;expression;language;javascript;dotnet;forma;formaui</PackageTags>
        <PackageProjectUrl>https://github.com/FormaUI/Nexo</PackageProjectUrl>
        <RepositoryUrl>https://github.com/FormaUI/Nexo</RepositoryUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <!-- Where a package came from: Source Link records the repository and the commit it was built from, which the full gate's pack sets ContinuousIntegrationBuild for, and the assembly's symbols ship beside the package. -->
    <PropertyGroup>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <EnablePackageValidation>true</EnablePackageValidation>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
        <None Include="..\NOTICE" Pack="true" PackagePath="\" Visible="false" />
        <None Include="..\README.md" Pack="true" PackagePath="\" Visible="false" />
        <!-- The SDK the build pins is the build's, never a consumer's. -->
        <Content Update="global.json" Pack="false" />
    </ItemGroup>

    <!-- The version: the implementation's release version src/language/Versions.mjs declares, so the package, the bundle and the sources report one version. -->
    <PropertyGroup>
        <VersionsSource>$(MSBuildProjectDirectory)\..\src\language\Versions.mjs</VersionsSource>
        <Version>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(VersionsSource)')), '(?s)^.*implementation = \x27([^\x27]+)\x27.*$', '$1'))</Version>
        <PackageVersion>$(Version)</PackageVersion>
        <!-- The release's entry in the changelog, at the release's tag. -->
        <PackageReleaseNotes>What Nexo $(Version) changed: https://github.com/FormaUI/Nexo/blob/v$(Version)/CHANGELOG.md#v$(Version.Replace('.', '-'))</PackageReleaseNotes>
    </PropertyGroup>

    <!-- A package without the bundle would ship nothing, and one whose bundle answers another version would misreport itself, so packing stops until publish.ps1 has made the bundle of this version. -->
    <Target Name="EnsureBundle" BeforeTargets="Pack">
        <Error Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\nexo.js')" Text="wwwroot/nexo.js is missing; run ./publish.ps1, which bundles Nexo and packs it." />
        <Error Condition="!$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\wwwroot\nexo.js').Contains('&quot;$(Version)&quot;'))" Text="wwwroot/nexo.js answers another version than $(Version); run ./publish.ps1, which bundles Nexo of this version and packs it." />
    </Target>

</Project>
