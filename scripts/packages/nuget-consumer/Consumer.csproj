<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- An application that references formaui-net.Nexo from its feed, at the version build.ps1 -Full gives as NexoVersion, and serves the package's files at _content/nexo/. -->
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="formaui-net.Nexo" Version="[$(NexoVersion)]" />
    </ItemGroup>

</Project>
