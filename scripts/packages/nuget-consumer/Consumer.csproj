<Project Sdk="Microsoft.NET.Sdk.Web">

    <!-- An application that references formaui-net.Nexo from its feed, at the version build.ps1 -Full gives as NexoVersion, and serves the package's files at _content/nexo/. An editor loads it without a version, as an application with no package; a build without one fails. -->
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup Condition="'$(NexoVersion)' != ''">
        <PackageReference Include="formaui-net.Nexo" Version="[$(NexoVersion)]" />
    </ItemGroup>

    <Target Name="RequireNexoVersion" BeforeTargets="Build" Condition="'$(NexoVersion)' == ''">
        <Error Text="NexoVersion names no version of formaui-net.Nexo to reference; ./build.ps1 -Full gives it." />
    </Target>

</Project>
